POSTGRES_DB=grmr
POSTGRES_USER=grmr
POSTGRES_PASSWORD=grmr
POSTGRES_PORT=5432
REDIS_PORT=6379

BACKEND_PORT=8080
# Local development only. Generate your own with: openssl rand -hex 32
JWT_SECRET=a5b8c67850564876fb9e4609bc476a159f282115a806c8cc8b50f0b5aac86b3b

FRONTEND_PORT=80

# Local-only admin seed account. Only takes effect on the "local" Spring profile
# (compose activates it automatically); LocalAdminSeeder creates this account once,
# idempotently, on backend startup. Leave any of these blank and the backend will
# fail fast at startup with a clear configuration error instead of running without one.
# Do not commit real values here.
LOCAL_ADMIN_LOGIN_ID=
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_NAME=

# Local-only student seed account (safe test credentials, not a real secret). Only takes effect on the
# "local" Spring profile (compose activates it automatically) and only when LOCAL_STUDENT_SEED_ENABLED=true;
# LocalStudentSeeder then creates this account once, idempotently, on backend startup. Set to false to
# disable seeding without needing to blank out the other values.
LOCAL_STUDENT_SEED_ENABLED=true
LOCAL_STUDENT_LOGIN_ID=student
LOCAL_STUDENT_PASSWORD=password
LOCAL_STUDENT_NAME=Local Student
